#!/usr/bin/env node
'use strict';
// Standalone pull worker: no Express server, Google SDK, Google key or database writes.
const fs=require('node:fs'),path=require('node:path');
const wait=ms=>new Promise(r=>setTimeout(r,ms));
class HttpError extends Error{constructor(status){super('Platform request failed');this.status=status}}
function loadConfig(file){const c=JSON.parse(fs.readFileSync(file,'utf8').replace(/^\uFEFF/,''));const url=new URL(c.platform_url),local=['127.0.0.1','localhost','[::1]'].includes(url.hostname);if(url.username||url.password||url.search||url.hash||url.pathname!=='/'||url.protocol!=='https:'&&!(local&&url.protocol==='http:'))throw Error('Use an HTTPS platform URL (HTTP is allowed only for localhost).');if(!/^[A-Za-z0-9_-]{36}\.[A-Za-z0-9_-]{43}$/.test(c.worker_token||''))throw Error('Invalid pairing file. Download a new worker configuration from the platform.');const model=String(c.model||'british-tutor-v1');if(!/^[A-Za-z0-9][A-Za-z0-9_./:-]{0,119}$/.test(model))throw Error('Invalid local model name.');const ollama=new URL(c.ollama_base_url||'http://127.0.0.1:11434');if(!['127.0.0.1','localhost','[::1]'].includes(ollama.hostname)||!['http:','https:'].includes(ollama.protocol)||ollama.username||ollama.password||ollama.search||ollama.hash||ollama.pathname!=='/')throw Error('Ollama must use a loopback address on this computer.');return {...c,platform_url:url.origin,ollama_base_url:ollama.origin,model,poll_seconds:Math.max(5,Math.min(60,Number(c.poll_seconds)||10))}}
function createWorker(config,{fetchImpl=fetch,stateDir=path.join(__dirname,'.worker-state'),log=console.log,generateImpl}={}){
 fs.mkdirSync(stateDir,{recursive:true,mode:0o700});const outbox=path.join(stateDir,'outbox.json');let stopped=false,busy=false;
 // Never use a cloud provider here, even if OPENAI_API_KEY exists elsewhere on the computer.
 async function generate(work,signal){if(generateImpl)return generateImpl(work,signal);const r=await fetchImpl(config.ollama_base_url+'/api/chat',{method:'POST',redirect:'error',signal:AbortSignal.any([signal,AbortSignal.timeout(240000)]),headers:{'Content-Type':'application/json'},body:JSON.stringify({model:config.model,stream:false,think:false,messages:[{role:'system',content:work.instructions},{role:'user',content:JSON.stringify(work.input)}],format:work.schema,options:{temperature:.2,num_ctx:16384,num_predict:Math.max(800,Math.min(8000,Number(work.maxOutput)||2500))},keep_alive:'10m'})});if(!r.ok)throw Error('Local model failed');const data=await r.json();if(!data.done||data.done_reason==='length'||typeof data.message?.content!=='string'||data.message.content.length>44000)throw Error('Invalid local output');return {value:JSON.parse(data.message.content),usage:{input:Number(data.prompt_eval_count)||0,output:Number(data.eval_count)||0}}}
 async function api(route,body){const r=await fetchImpl(config.platform_url+'/api/ai-worker/'+route,{method:'POST',redirect:'error',signal:AbortSignal.timeout(30000),headers:{Authorization:'Bearer '+config.worker_token,'Content-Type':'application/json'},body:JSON.stringify(body)});if(!r.ok)throw new HttpError(r.status);return r.json()}
 async function modelReady(){try{const r=await fetchImpl(config.ollama_base_url+'/api/tags',{redirect:'error',signal:AbortSignal.timeout(5000)});if(!r.ok)return false;const data=await r.json();return (data.models||[]).some(m=>m.name===config.model||m.name===config.model+':latest')}catch{return false}}
 function save(value){const temp=outbox+'.tmp';fs.writeFileSync(temp,JSON.stringify(value),{mode:0o600});fs.renameSync(temp,outbox)}
 function clear(){fs.rmSync(outbox,{force:true})}
 async function deliver(){if(!fs.existsSync(outbox))return true;let item;try{item=JSON.parse(fs.readFileSync(outbox,'utf8'))}catch{throw Error('Outbox is invalid; move it aside and restart. Do not post its contents publicly.')}try{await api('jobs/'+item.id+'/complete',item.body);clear();log('Result acknowledged by the platform.');return true}catch(e){if(e.status===401||e.status===403){stopped=true;log('Pairing was revoked or access changed. Download a new configuration.');return false}if([400,404,409].includes(e.status)){clear();log('The platform rejected an expired, canceled, or invalid result; it was not published.');return true}log('Connection unavailable. Result remains in the private outbox for retry.');return false}}
 async function step(){if(busy||stopped)return;busy=true;try{if(!await deliver())return;const ready=await modelReady();const claim=await api('claim',{model:config.model,model_ready:ready});if(!ready){log('Ollama/model is not ready. Waiting; queued platform requests are retained.');return}if(!claim.job)return;const job=claim.job;if(typeof job.id!=='string'||typeof job.lease_token!=='string'||!job.work?.schema||typeof job.work.instructions!=='string')throw Error('Invalid job');const abort=new AbortController();let heartbeatBusy=false,leaseValid=true;const heartbeat=setInterval(async()=>{if(heartbeatBusy)return;heartbeatBusy=true;try{await api('jobs/'+job.id+'/heartbeat',{lease_token:job.lease_token,model:config.model,model_ready:true})}catch(e){if([401,403,404,409].includes(e.status)){leaseValid=false;abort.abort();if(e.status===401)stopped=true}}finally{heartbeatBusy=false}},30000);heartbeat.unref?.();log('Generating one queued request locally…');try{const result=await generate(job.work,abort.signal);if(leaseValid){save({id:job.id,body:{lease_token:job.lease_token,value:result.value,usage:result.usage}});await deliver()}}catch{if(leaseValid){log('Local generation did not complete; reporting a safe retry status.');try{await api('jobs/'+job.id+'/fail',{lease_token:job.lease_token,code:'generation_failed'})}catch{log('Could not report failure; the lease will expire automatically.')}}}finally{clearInterval(heartbeat)}}catch(e){if(e.status===401||e.status===403){stopped=true;log('Invalid/revoked pairing. Download a new configuration from the administrator.')}else log('Platform connection unavailable. Retrying without changing platform data.')}finally{busy=false}}
 return {step,deliver,stop:()=>{stopped=true},run:async()=>{log('Local worker started. No Google credentials are used.');while(!stopped){await step();if(!stopped)await wait(config.poll_seconds*1000)}},isStopped:()=>stopped};
}
function acquireLock(dir){fs.mkdirSync(dir,{recursive:true,mode:0o700});const file=path.join(dir,'worker.lock');for(let attempt=0;attempt<2;attempt++){try{const fd=fs.openSync(file,'wx',0o600);fs.writeFileSync(fd,String(process.pid));fs.closeSync(fd);return ()=>{try{if(fs.readFileSync(file,'utf8')===String(process.pid))fs.unlinkSync(file)}catch{}}}catch(e){if(e.code!=='EEXIST')throw e;const pid=Number(fs.readFileSync(file,'utf8'));let live=false;try{if(Number.isInteger(pid)&&pid>0){process.kill(pid,0);live=true}}catch(err){if(err.code==='EPERM')live=true}if(live)throw Error('Worker already running');fs.rmSync(file,{force:true})}}throw Error('Could not lock worker folder')}
if(require.main===module){try{const args=process.argv.slice(2),configFile=path.resolve(__dirname,args.find(a=>a!=='--once')||'local-worker-config.json'),config=loadConfig(configFile),release=acquireLock(path.join(__dirname,'.worker-state')),runner=createWorker(config);process.on('exit',release);process.on('SIGINT',()=>{runner.stop();process.exit(0)});process.on('SIGTERM',()=>{runner.stop();process.exit(0)});if(args.includes('--once'))runner.step().catch(()=>process.exitCode=1);else runner.run().catch(()=>{console.error('Worker stopped. Check configuration and local file permissions.');process.exitCode=1})}catch{console.error('Could not start the worker. Check its private pairing file and close any other worker window. Put local-worker-config.json in this folder and use Node 20 or later.');process.exitCode=1}}
module.exports={loadConfig,createWorker,acquireLock};
