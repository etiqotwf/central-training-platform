PORT=3000
NODE_ENV=production
# Google Sheet ID (the service account must have Editor access to this spreadsheet)
GOOGLE_SHEETS_SPREADSHEET_ID=1XX20LVRFvfjIjc1HMR1HfcS4uGa1fjUS3ui4l_m2knM
# Render secret file path, or path to service-account JSON locally
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/google-service-account.json
# Required in production
SESSION_SECRET=replace_with_random_secret_at_least_32_characters
SETUP_KEY=replace_with_a_long_one_time_setup_key


# Google Drive folder; V26 uploads use the Apps Script bridge below
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=13xUHOP92OyWO0KIJvxu1jFE2ijFbg7_u

# V26 owner-executed Apps Script bridge for Gmail and personal Drive (no service-account storage quota)
PLATFORM_SCRIPT_URL=https://script.google.com/macros/s/YOUR_NEW_DEPLOYMENT_ID/exec
# Use the SAME random secret (32+ characters) in Apps Script > Script Properties
PLATFORM_BRIDGE_SECRET=replace_with_a_random_secret_of_32_or_more_characters
# Your actual public website URL, included in trainee login emails
PLATFORM_PUBLIC_URL=https://your-platform.example.com

# Optional legacy paid provider only when AI_PROVIDER=openai; not needed for V32
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# V32 default: your own Ollama host. No paid provider fallback.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Only for a private HTTPS gateway on a separate inference host (e.g. Render -> your host)
OLLAMA_API_KEY=

# V33: async local worker. Existing Google/email settings stay unchanged.
# Can also be chosen from the admin AI settings page.
AI_EXECUTION=queue

# Facebook Page course showcase (server-side only)
FACEBOOK_PAGE_ID=dtccontact
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v24.0

# Persistent Facebook gallery (Supabase)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=facebook-course-images
# Optional: protect Make -> Render sync endpoint with a shared secret
MAKE_SYNC_SECRET=
