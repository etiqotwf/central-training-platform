PORT=3000
NODE_ENV=production
# Google Sheet ID (the service account must have Editor access to this spreadsheet)
GOOGLE_SHEETS_SPREADSHEET_ID=1XX20LVRFvfjIjc1HMR1HfcS4uGa1fjUS3ui4l_m2knM
# Render secret file path, or path to service-account JSON locally
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/google-service-account.json
# Required in production
SESSION_SECRET=replace_with_random_secret_at_least_32_characters
SETUP_KEY=replace_with_a_long_one_time_setup_key


# Google Drive folder; V26 uploads use the Apps Script bridge below
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=13xUHOP92OyWO0KIJvxu1jFE2ijFbg7_u
# Central Knowledge AI V42: share this folder with the service-account email as Editor for 50 MiB uploads.
# Direct Google Drive service-account storage supports up to 50 MiB; Apps Script Bridge fallback supports up to 8 MiB.

# Separate Apps Script deployments: archive (legacy PlatformBridge.gs) and Knowledge library.
# ARCHIVE Apps Script keeps Script Properties PLATFORM_BRIDGE_SECRET and PLATFORM_FOLDER_ID.
ARCHIVE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_ARCHIVE_DEPLOYMENT_ID/exec
ARCHIVE_BRIDGE_SECRET=replace_with_archive_secret_at_least_32_characters
# KNOWLEDGE Apps Script uses Script Properties KNOWLEDGE_BRIDGE_SECRET and KNOWLEDGE_FOLDER_ID.
KNOWLEDGE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_KNOWLEDGE_DEPLOYMENT_ID/exec
KNOWLEDGE_BRIDGE_SECRET=replace_with_knowledge_secret_at_least_32_characters
# Legacy archive aliases are still accepted during migration; remove after validation.
# PLATFORM_SCRIPT_URL=
# PLATFORM_BRIDGE_SECRET=
# Your actual public website URL, included in trainee login emails
PLATFORM_PUBLIC_URL=https://your-platform.example.com

# Optional legacy paid provider only when AI_PROVIDER=openai; not needed for V32
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# V32 default: your own Ollama host. No paid provider fallback.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Only for a private HTTPS gateway on a separate inference host (e.g. Render -> your host)
OLLAMA_API_KEY=

# V33: async local worker. Existing Google/email settings stay unchanged.
# Can also be chosen from the admin AI settings page.
AI_EXECUTION=queue

# Facebook Page course showcase (server-side only)
FACEBOOK_PAGE_ID=dtccontact
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v24.0

# Persistent Facebook gallery (Supabase)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=facebook-course-images
# Optional: protect Make -> Render sync endpoint with a shared secret
MAKE_SYNC_SECRET=

# Optional Google service-account credential formats (use ONE method only).
# Prefer platform secrets on Railway; never commit actual credentials.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Required only for deliberate, separately reviewed bootstrap/bulk-delete operations; leave disabled.
GOOGLE_SHEETS_ALLOW_EMPTY_BOOTSTRAP=false
GOOGLE_SHEETS_ALLOW_BULK_DELETE=false
# Keep the existing DATA_ENCRYPTION_KEY secret unchanged when encrypted-at-rest is enabled.
DATA_ENCRYPTION_KEY=
